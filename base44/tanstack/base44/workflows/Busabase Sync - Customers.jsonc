{
  "name": "Busabase Sync - Customers",
  "description": "When a Customer is created or updated, push it to Busabase",
  "trigger": {
    // entity_name must be your entity's name; "entity" in the args must match shared/mappings.ts.
    "config": {
      "trigger_type": "entity",
      "entity_name": "Customer",
      "events": ["create", "update"]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "busabase_sync_customers",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "push_to_busabase": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/busabase-sync",
            "method": "POST",
            "body": {
              "entity": "Customer",
              "entity_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": { "title": "Push customer to Busabase" }
        }
      }
    ]
  }
}
