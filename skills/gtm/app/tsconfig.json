{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "~/domains/gtm/data": ["../../../../packages/gtm-data/src/index.ts"],
      "~/domains/gtm/data/*": ["../../../../packages/gtm-data/src/*"],
      "gtm-data": ["../../../../packages/gtm-data/src/index.ts"],
      "gtm-data/*": ["../../../../packages/gtm-data/src/*"],
      "sharelib/data-table": ["../../../../packages/sharelib/data-table/index.ts"],
      "sharelib/*": ["../../../../packages/sharelib/*"],
      "kui/*": ["../../../../packages/kui/src/components/ui/*"]
    }
  },
  "include": ["src"]
}
